                listatotal.append(resposta2)
            return listatotal
        
    elif resposta==3:
        def somaElem(listatotal):
            soma=0
            for n in listatotal:
                soma=soma+n
            return soma
    elif resposta==4:
        def mediaElem(listatotal):
            soma=0
            quantidade=len(listatotal)
            for n in listatotal:
                soma=soma+n
                quantidade=len(listatotal)
            return soma/quantidade
    elif resposta==5:
        def maiorElem(listatotal):
            i=0
            maior=listatotal[0]
            for n in listatotal:
                if maior<n:
                    maior=n
            return maior 
    elif resposta==6:
        def menorElem(listatotal):
            i=0
            menor=listatotal[0]
            for n in listatotal:
                if menor>n:
                    menor=n         
            return menor
         
    elif resposta==7:  
        def ordenada(listatotal)  :
            ordenada=True
            for i in range(len(listatotal)-1):
                if listatotal[i]>listatotal[i+1]:
                    ordenada=False
            return ordenada
    elif resposta==8:   
        def desordenada(listatotal) : 
            desordenada=True
            for i in range(len(listatotal)-1):
                if listatotal[i]<listatotal[i+1]:
                     desordenada=False
            return desordenada
    elif resposta==9: 
        def posição(listatotal):
            numero=int(input("Introduza um número"))
            i=0
            res=-1
            for n in listatotal:
                if n==numero:
                    res=i
                i=i+1
            return res 
