resposta=int(input("Escolhas um numero de 0 a 9"))
while resposta!=0:
    if resposta==1:
        def Lista1(N):
            listatotal=[]
            for i in range(N):
                listatotal.append(random.randint(1,100))
            return listatotal 
    elif resposta==2:
        def Lista2(N):
            N=int(input("Quantos elementos?"))
            listatotal=[]         
